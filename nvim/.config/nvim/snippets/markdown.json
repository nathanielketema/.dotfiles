    "daily": {
        "prefix": "daily",
        "body": [
            "---",
            "date: [$CURRENT_HOUR:$CURRENT_MINUTE, $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE]",
            "---",
            "",
            "",
            "# Today's Schedule",
            "",
