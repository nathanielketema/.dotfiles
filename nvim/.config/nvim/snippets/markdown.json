        ]
    },
    "pandoc": {
        "prefix": "pandoc",
        "body": [
            "---",
            "title: \"$1\"",
            "author: \"$2\"",
            "date: \\today",
            "geometry: margin=1in",
            "documentclass: extarticle",
            "fontsize: 12pt",
            "linkcolor: blue",
            "numbersections: false",
            "mainfont: \"Times New Roman\"",
            "monofont: \"Courier New\"",
            "header-includes:",
            "    - \\usepackage{titlesec}",
            "    - \\titleformat{\\section}{\\LARGE\\bfseries\\centering}{\\thesection}{1em}{}",
            "    - \\titleformat{\\subsection}{\\Large\\bfseries}{\\thesection}{1em}{}",
            "---",
            "",
            "$0"
        ]
    }
}
